# Optional headless overrides. Prefer `steering configure-provider`, which stores
# credentials in the operating-system keyring. Never commit real values here.
STEERING_GENERATION_PROVIDER=openai-compatible
STEERING_GENERATION_BASE_URL=https://api.example.com/v1
STEERING_GENERATION_MODEL=your-generation-model
STEERING_GENERATION_CONTEXT_WINDOW_TOKENS=32000
STEERING_GENERATION_RESERVED_OUTPUT_TOKENS=4000
STEERING_GENERATION_API_KEY=

STEERING_EMBEDDING_PROVIDER=openai-compatible
STEERING_EMBEDDING_BASE_URL=https://api.example.com/v1
STEERING_EMBEDDING_MODEL=your-embedding-model
STEERING_EMBEDDING_DIMENSION=1536
STEERING_EMBEDDING_API_KEY=
