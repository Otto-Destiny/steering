# Copy this file to .env.local. Never commit real values.
# Supported simple providers: gemini or openai. STEERING_MODEL is optional.
STEERING_PROVIDER=gemini
STEERING_API_KEY=your-api-key
# STEERING_MODEL=gemini-3.5-flash

# Advanced role-specific overrides remain available when generation and
# embeddings use different providers.
# STEERING_GENERATION_PROVIDER=openai-compatible
# STEERING_GENERATION_BASE_URL=https://api.example.com/v1
# STEERING_GENERATION_MODEL=your-generation-model
# STEERING_GENERATION_API_KEY=your-generation-key
# STEERING_EMBEDDING_PROVIDER=local-fastembed
# STEERING_EMBEDDING_MODEL=your-embedding-model
# STEERING_EMBEDDING_DIMENSION=768
# STEERING_EMBEDDING_API_KEY=your-embedding-key

# Signed-in browser capture. Signing in is always visible because a human types
# the credentials; once the session is stored, captures can replay it without a
# window, which is what makes unattended runs possible.
# STEERING_BROWSER_HEADLESS=true

# Optional, billed per read. Only needed for unattended thread reads or API
# bookmark import; the free public and signed-in browser paths need nothing here.
# STEERING_X_API_CLIENT_ID=your-oauth2-client-id

# When to read an X post's replies. "when-needed" (default) reads them only if
# the root post has no source worth following, or says the link is in the
# replies. "always" reads them whenever a post has replies. "never" keeps every
# capture to the root post.
# STEERING_READ_THREADS=when-needed
